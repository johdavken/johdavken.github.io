{
  "name": "resin-tools-android-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor Android shell for Resin.tools. The canonical web app is the repo root; this only wraps it for Android. Not used by the GitHub Pages web deployment.",
  "scripts": {
    "build:android": "node scripts/build-www.js",
    "sync:android": "npm run build:android && npx cap sync android",
    "open:android": "npx cap open android",
    "build:notes-editor": "esbuild notes-editor-vendor.src.js --bundle --minify --format=iife --global-name=RTNotesEditor --target=es2019 --legal-comments=none --outfile=vendor/tiptap-notes.min.js",
    "build:qrcode": "esbuild node_modules/qrcode/lib/browser.js --bundle --minify --format=iife --global-name=QRCode --target=es2019 --outfile=vendor/qrcode.min.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.2",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/local-notifications": "8.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tiptap/core": "2.27.2",
    "@tiptap/extension-task-item": "2.27.2",
    "@tiptap/extension-task-list": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
