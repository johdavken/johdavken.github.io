<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/colorPrimaryDark">

    <TextView
        android:id="@+id/pumpOffAlarmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#ffffff"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="Pump off" />

    <TextView
        android:id="@+id/pumpOffAlarmBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="48dp"
        android:textColor="#e6ecf2"
        android:textSize="18sp"
        android:gravity="center"
        android:text="Hopper pump-off is due now." />

    <Button
        android:id="@+id/pumpOffAlarmOpenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Open Resin.Tools" />

    <Button
        android:id="@+id/pumpOffAlarmDismissButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dismiss" />

</LinearLayout>
